# MotoNav backend — SERVER-ONLY secrets. Never expose these to the frontend
# and never commit a real .env.

# Supabase → Project Settings → Database → Connection string (URI).
DATABASE_URL=postgresql://postgres.fsnibbciwpfhjwuficmp:Keshor2006%249@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres


# Long random string used to sign rider session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of frontend origins allowed to call this API (CORS + Socket.IO).
# Example: https://motonav.vercel.app,http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173

# Single-origin alternative to CLIENT_ORIGINS — set one or the other, not
# both. Accepted because deployment docs/dashboards vary on which name they
# expect. Example: https://motonav.vercel.app
FRONTEND_URL=http://localhost:5173

# Render/Railway/Fly set PORT automatically.
PORT=4000
NODE_ENV=development

# ---- Rider voice (WebRTC) ----
# Voice is peer-to-peer; the server only relays signalling. STUN alone connects most
# riders, but riders behind strict mobile-carrier NATs need a TURN relay. Optional —
# leave blank to use Google's public STUN only. Get TURN credentials from a provider
# (Metered, Twilio, Cloudflare, or your own coturn). Never commit real values.
STUN_URLS=
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---- Stage 5: Moto News ----
# NewsAPI.org key (https://newsapi.org). Server-only: the browser calls
# GET /api/news/motorcycle on THIS backend and never sees the key.
# Leave blank and the endpoint answers 503 "not_configured" (the page shows a friendly state).
NEWS_API_KEY=5af106acc7744f4997cbe9b7e23196b7
# Optional override (e.g. a proxy). Defaults to https://newsapi.org
NEWS_API_BASE_URL=https://newsapi.org

# ---- Stage 5: Moto Community voice messages (Supabase Storage) ----
# SERVER-ONLY. The service-role key bypasses Row Level Security — never put it in a
# VITE_ variable, never commit it, never send it to the browser.
# Supabase → Project Settings → API → Project URL / service_role key.
SUPABASE_URL=https://fsnibbciwpfhjwuficmp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZzbmliYmNpd3BmaGp3dWZpY21wIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MTA4NTc5MiwiZXhwIjoyMTA2NjYxNzkyfQ.Rd6LPk9Y1USX91KcHfkvfvN13Bzk29NR87qsqzFvzqw
# Private bucket created in the Supabase dashboard (see README). Default: community-audio
SUPABASE_AUDIO_BUCKET=community-audio
