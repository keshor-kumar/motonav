# MotoNav — environment variables
# Copy this file to .env and fill in your own keys. Never commit real keys.

# Geoapify — geocoding/place search, nearby Places API, and Routing API.
# Get a free key at https://www.geoapify.com/
VITE_GEOAPIFY_API_KEY=

# MapTiler — map tiles/style for the interactive map.
# Get a free key at https://www.maptiler.com/
VITE_MAPTILER_API_KEY=

VITE_APP_NAME=MotoNav

# ---------- Stage 3: real group rides backend ----------

# MotoNav backend base URL (REST + Socket.IO). In dev, defaults to
# http://localhost:4000 automatically if left blank — only required in
# production (e.g. https://motonav-api.onrender.com).
VITE_API_BASE_URL=

# Public origin used to build shareable /join/<code> links and QR codes.
# Falls back to the browser's current origin if left blank — set this
# explicitly in production (e.g. https://motonav.vercel.app) so links are
# never wrong regardless of which URL someone happens to load the app from.
VITE_PUBLIC_APP_URL=

# Socket.IO connection target. Leave blank — it defaults to
# VITE_API_BASE_URL, which is correct for this project (REST + Socket.IO
# are served by the same backend process). Only set this separately if
# you split them onto different hosts.
VITE_SOCKET_URL=
